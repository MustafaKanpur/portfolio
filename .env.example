# Copy to .env.local and fill in. Never commit .env.local.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=mkanpurw@my.yorku.ca

# Optional. The sender address. Defaults to Resend's test sender (onboarding@resend.dev),
# which can only deliver to your own Resend account email. Verify a domain in Resend to change it.
# CONTACT_FROM_EMAIL="Portfolio <hello@yourdomain.com>"

# Optional. Your public URL, used for the sitemap, canonical URLs, and OG images.
# Defaults to Vercel's production URL, or http://localhost:3000 locally.
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
